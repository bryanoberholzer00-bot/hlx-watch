{
  // Cloudflare Worker che risponde a /start e /help del bot Telegram di HLX Watch.
  // Segreti: wrangler secret put BOT_TOKEN | WEBHOOK_SECRET | OWNER_CHAT_ID
  "name": "hlx-watch-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // controllo esterno: ogni 6 ore verifica che il sito venga ancora aggiornato
  "triggers": { "crons": ["23 */6 * * *"] },
  // iscrizioni alle notifiche di sistema del sito (src/push.js); segreti VAPID_PRIVATE_JWK e PUSH_SECRET
  "kv_namespaces": [{ "binding": "SUBS", "id": "3953cebed25949fc8c39ea05674d00d4" }],
  "observability": { "enabled": true }
}
