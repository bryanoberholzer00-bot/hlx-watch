# Token GitHub personale (opzionale ma consigliato: 5000 richieste/ora invece di 60)
# Crea un token classic senza scope oppure fine-grained in sola lettura sui repo pubblici
GITHUB_TOKEN=

# Discord: URL del webhook del canale
DISCORD_WEBHOOK_URL=

# Telegram: token del bot (da @BotFather) e chat id (da @userinfobot oppure getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chiave Steam Web API (opzionale, gratuita: https://steamcommunity.com/dev/apikey)
# Serve solo per la lista completa delle app (rilevamento preciso delle app nuove)
STEAM_WEB_API_KEY=

# Percorso del config (opzionale, default ./config.yaml)
# HLXWATCH_CONFIG=config.yaml
