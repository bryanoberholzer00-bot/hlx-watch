{
 "temi": {
  "t1": {
   "titolo": "Impostazioni 'mod != hlx' nell'editor degli effetti particellari",
   "spiegazione": "Negli schemi del motore condiviso da CS2, Deadlock e Dota 2 molte opzioni degli effetti particellari sono nascoste a meno che il progetto attivo (il 'mod') sia hlx, a volte insieme a csgo o dota. Le stesse espressioni compaiono anche nelle stringhe degli strumenti e in un file di servizio del repository. Alcune varianti sono state aggiunte o modificate nel 2026: segno che gli strumenti trattano HLX come un progetto vero e attivo, con opzioni dedicate come la rifrazione e l'illuminazione per vertice.",
   "rilevanza": "alta",
   "cerca": "mod != hlx",
   "creato": "2026-10-26T21:17:52Z"
  },
  "t2": {
   "titolo": "HLX nel bug reporter di Valve",
   "spiegazione": "Il file di configurazione dello strumento interno per segnalare bug, presente nei dati di CS2 e Deadlock, elenca HLX come prodotto e come componente, accanto agli altri giochi. Significa che all'interno di Valve si aprono segnalazioni di bug per un progetto chiamato HLX. È presente almeno da agosto 2024.",
   "rilevanza": "alta",
   "cerca": "bugreporter HLX",
   "creato": "2026-10-26T21:17:52Z"
  },
  "t3": {
   "titolo": "Thumper (HLX) nella definizione dei personaggi AI",
   "spiegazione": "Nel file che descrive le entità dei personaggi controllati dal computer (presente in CS2 e Dota 2) c'è una voce 'Thumper (HLX)' che fa scappare brevemente gli antlion. Thumper e antlion sono elementi di Half-Life 2, e l'etichetta HLX indica che questo comportamento è pensato per quel progetto. Presente almeno da luglio 2025.",
   "rilevanza": "alta",
   "cerca": "Thumper (HLX)",
   "creato": "2026-10-26T21:17:52Z"
  },
  "t4": {
   "titolo": "hlx_physics_particle_spawner negli strumenti di CS2",
   "spiegazione": "Alcuni strumenti di CS2 contenevano un riferimento a un generatore di particelle fisiche chiamato hlx_physics_particle_spawner, definito in un file di configurazione delle particelle fisiche. Il riferimento risulta rimosso nei dati del luglio 2026. Indica un elemento creato apposta per HLX, ma la rimozione potrebbe essere solo una pulizia del codice condiviso.",
   "rilevanza": "media",
   "cerca": "hlx_physics_particle_spawner",
   "creato": "2026-10-26T21:17:52Z"
  },
  "t5": {
   "titolo": "Cartella 'content/hlx' nei percorsi degli strumenti",
   "spiegazione": "Una libreria degli strumenti di CS2, Deadlock e Dota 2 contiene percorsi di file di prova per le particelle dentro una cartella content\\hlx sul computer di sviluppo di Valve. Mostra che esiste una cartella di contenuti dedicata a HLX nell'archivio di lavoro, ma si tratta di semplici texture di test presenti almeno dal 2022.",
   "rilevanza": "media",
   "cerca": "content\\hlx",
   "creato": "2026-10-26T21:17:52Z"
  },
  "t6": {
   "titolo": "Animazioni dalla cartella hl3 in Half-Life: Alyx",
   "spiegazione": "I file di Half-Life: Alyx contengono librerie di pose e animazioni (Lazlo, Tanaka, lo zombie cieco 'Larry') esportate tra fine 2017 e inizio 2018 da una cartella chiamata hl3 sui computer di sviluppo. È un riferimento reale ma vecchio: con ogni probabilità hl3 era il nome della cartella di lavoro del progetto poi uscito come Alyx nel 2020, non un indizio di un nuovo gioco.",
   "rilevanza": "media",
   "cerca": "content/hl3",
   "creato": "2026-10-26T21:17:52Z"
  },
  "t7": {
   "titolo": "'HLX' nella libreria OpenImageDenoise",
   "spiegazione": "Nella libreria di riduzione del rumore delle immagini OpenImageDenoise (di Intel, non di Valve) compaiono sequenze come 'HLX=' e ';HLX>'. Sono frammenti casuali di dati binari interpretati come testo, una pura coincidenza di lettere.",
   "rilevanza": "rumore",
   "cerca": "OpenImageDenoise HLX",
   "creato": "2026-10-26T21:17:52Z"
  }
 },
